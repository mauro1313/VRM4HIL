# VRM4-HIL - root Makefile.
# Every artifact in the repository is regenerated by one of these targets (VER-07).
# Targets with no sources print a warning and exit without error: in M0 the CI
# must stay green even on the bare skeleton. Once an area has its own sources,
# the check becomes real.

SHELL := /bin/bash
.ONESHELL:
.SHELLFLAGS := -eu -o pipefail -c

CTRL_RTL   := $(wildcard ctrl/rtl/*.v ctrl/rtl/*.sv)
PLANT_RTL  := $(wildcard plant/rtl/*.v plant/rtl/*.sv)
TB_DIRS    := $(patsubst %/Makefile,%,$(wildcard ctrl/tb/*/Makefile plant/tb/*/Makefile))
SBY_FILES  := $(wildcard ctrl/formal/*.sby)

.PHONY: help lint test formal ice40 prog pytest hw report docs clean

help:  ## list the targets
	@grep -E '^[a-z0-9_-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-10s %s\n", $$1, $$2}'

lint:  ## lint the portable RTL (rtl/ only, never board/: board primitives stay out)
	@if [ -z "$(strip $(CTRL_RTL) $(PLANT_RTL))" ]; then echo "lint: no sources in */rtl, skipping"; exit 0; fi
	for f in $(CTRL_RTL) $(PLANT_RTL); do
	  echo "lint: $$f"
	  verilator --lint-only -Wall -Wno-DECLFILENAME "$$f"
	done

test:  ## cocotb unit tests: one subfolder per testbench in ctrl/tb and plant/tb
	@if [ -z "$(strip $(TB_DIRS))" ]; then echo "test: no cocotb testbench, skipping"; exit 0; fi
	for d in $(TB_DIRS); do
	  echo "test: $$d"
	  rm -f "$$d/results.xml"
	  $(MAKE) -C "$$d"
	  # Exit code alone is not trusted: the results file is checked.
	  test -f "$$d/results.xml" || { echo "test: $$d did not produce results.xml"; exit 1; }
	  if grep -q "<failure" "$$d/results.xml"; then echo "test: FAILED in $$d"; exit 1; fi
	done

formal:  ## SymbiYosys formal proofs (all tasks of every .sby)
	@if [ -z "$(strip $(SBY_FILES))" ]; then echo "formal: no .sby file, skipping"; exit 0; fi
	for f in $(SBY_FILES); do
	  echo "formal: $$f"
	  (cd "$$(dirname $$f)" && sby -f "$$(basename $$f)")
	done

ice40:  ## synthesis, place-and-route, and bitstream for the controller
	$(MAKE) -C ctrl bin

prog:  ## program the iCE40 board
	$(MAKE) -C ctrl prog

pytest:  ## Python tests for the models and software
	# pytest returns 5 if it finds no tests: in M0 this is normal, not an error.
	pytest model sw || [ $$? -eq 5 ]

hw:  ## plant bitstream with Vivado (requires Vivado 2024.1 installed)
	@test -f plant/hw/build.tcl || { echo "hw: plant/hw/build.tcl does not exist yet"; exit 1; }
	vivado -mode batch -source plant/hw/build.tcl -tclargs --out build/plant

report:  ## D5 acceptance report from the results files (M6)
	@echo "report: not written yet (VER-06, DOC-03)"; exit 1

docs:  ## documentation generated from docs/icd/regs.yaml (M2)
	@echo "docs: not written yet (IF-06)"; exit 1

clean:  ## remove the generated output
	rm -rf build ctrl/build
	find . -name sim_build -type d -prune -exec rm -rf {} +
	find . -name results.xml -delete
